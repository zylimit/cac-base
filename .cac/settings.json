{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(.env.local)",
      "Read(**/.env.local)",
      "Read(.env.development)",
      "Read(**/.env.development)",
      "Read(.env.production)",
      "Read(**/.env.production)",
      "Read(.env.staging)",
      "Read(**/.env.staging)",
      "Read(.env.test)",
      "Read(**/.env.test)",
      "Read(secrets/**)",
      "Read(**/secrets/**)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/credentials)",
      "Read(**/credentials.json)",
      "Read(**/.credentials.json)"
    ],
    "ask": [
      "Bash(gh release *)",
      "Bash(npm publish*)",
      "Bash(docker push*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/session-start.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/release-gate.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node .cac/hooks/detect-feedback-signal.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/secret-exfil-guard.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node .cac/hooks/dangerous-command-guard.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node .cac/hooks/pre-commit-check.mjs",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node .cac/hooks/kill-dev-ports.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/no-direct-code-guard.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/tdd-gate.mjs",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/release-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Shell",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/auto-push.mjs",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/mark-review-needed.mjs",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node .cac/hooks/record-authorship.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/subagent-bookkeeping.mjs --start",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/subagent-bookkeeping.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/precompact-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/postcompact-reinject.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .cac/hooks/stop-gate.mjs",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node .cac/hooks/three-file-sync-gate.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
